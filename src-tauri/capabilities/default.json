{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "v0.1: the three bundled sidecars, plus asset access for playback.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/yt-dlp", "sidecar": true, "args": true },
        { "name": "binaries/ffmpeg", "sidecar": true, "args": true },
        { "name": "binaries/deno", "sidecar": true, "args": true }
      ]
    }
  ]
}
