                   "hover":    { "sheet": "chrome", "rect": [14, 98, 13, 9], "tint": "strike" },
                   "active":   { "sheet": "chrome", "rect": [28, 98, 13, 9], "tint": "strike" },
                   "inactive": { "sheet": "chrome", "rect": [42, 98, 13, 9], "tint": "filament" },
                   "action": "close" },

        "clock": { "type": "text", "rect": [4, 31, 56, 17], "font": "clock", "bind": "elapsed",
                   "tint": "arc", "glow": true },
        "tagPlay": { "type": "text", "rect": [4, 51, 15, 8], "font": "tag", "value": "PLAY",
                     "tint": "filament", "opacity": 0.35,
                     "lit": { "bind": "playState", "when": "playing", "tint": "arc", "opacity": 1 } },
        "tagPause": { "type": "text", "rect": [22, 51, 18, 8], "font": "tag", "value": "PAUSE",
                      "tint": "filament", "opacity": 0.35,
                      "lit": { "bind": "playState", "when": "paused", "tint": "arc", "opacity": 1 } },
        "tagStop": { "type": "text", "rect": [44, 51, 16, 8], "font": "tag", "value": "STOP",
                     "tint": "filament", "opacity": 0.35,
                     "lit": { "bind": "playState", "when": "stopped", "tint": "strike", "opacity": 1 } },

        "vis": { "type": "visualizer", "rect": [65, 18, 206, 41] },

        "stripWell": { "type": "image", "rect": [4, 63, 267, 17],
                       "sprite": { "sheet": "chrome", "rect": [10, 0, 4, 4], "tint": "well" } },
        "stripFrame": { "type": "nineslice", "rect": [4, 63, 267, 17],
                        "sprite": { "sheet": "chrome", "rect": [0, 0, 8, 8], "tint": "arc" },
                        "insets": [1, 1, 1, 1], "opacity": 0.14 },
        "trackTitle": { "type": "text", "rect": [8, 63, 259, 17], "font": "strip",
                        "bind": "trackTitle", "tint": "filament", "overflow": "scroll" },

        "seekWell": { "type": "image", "rect": [4, 84, 267, 9],
                      "sprite": { "sheet": "chrome", "rect": [10, 0, 4, 4], "tint": "well" } },
        "seekFrame": { "type": "nineslice", "rect": [4, 84, 267, 9],
                       "sprite": { "sheet": "chrome", "rect": [0, 0, 8, 8], "tint": "arc" },
                       "insets": [1, 1, 1, 1], "opacity": 0.14 },
        "seek": { "type": "slider", "rect": [4, 84, 267, 9], "orientation": "horizontal",
                  "bind": "position",
                  "fill":  { "sheet": "chrome", "rect": [0, 110, 32, 9], "tint": "arc" },
                  "thumb": { "sheet": "chrome", "rect": [48, 110, 9, 13], "tint": "arc" } },

        "prev": { "type": "button", "rect": [4, 97, 17, 14],
                  "sprite": { "sheet": "chrome", "rect": [0, 126, 17, 14], "tint": "arc" },
                  "hover":  { "sheet": "chrome", "rect": [18, 126, 17, 14], "tint": "arc" },
                  "active": { "sheet": "chrome", "rect": [36, 126, 17, 14], "tint": "arc" },
                  "action": "prev" },
        "play": { "type": "toggle", "rect": [22, 97, 17, 14],
