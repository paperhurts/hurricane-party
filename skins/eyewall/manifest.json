                  "hover":  { "sheet": "chrome", "rect": [18, 156, 17, 14], "tint": "arc" },
                  "active": { "sheet": "chrome", "rect": [36, 156, 17, 14], "tint": "arc" },
                  "on": {
                    "sprite": { "sheet": "chrome", "rect": [0, 171, 17, 14], "tint": "arc" },
                    "hover":  { "sheet": "chrome", "rect": [18, 171, 17, 14], "tint": "arc" },
                    "active": { "sheet": "chrome", "rect": [36, 171, 17, 14], "tint": "arc" }
                  },
                  "action": "play", "bind": "playState", "when": "playing" },
        "pause": { "type": "toggle", "rect": [40, 97, 17, 14],
                   "sprite": { "sheet": "chrome", "rect": [0, 186, 17, 14], "tint": "arc" },
                   "hover":  { "sheet": "chrome", "rect": [18, 186, 17, 14], "tint": "arc" },
                   "active": { "sheet": "chrome", "rect": [36, 186, 17, 14], "tint": "arc" },
                   "on": {
                     "sprite": { "sheet": "chrome", "rect": [0, 201, 17, 14], "tint": "arc" },
