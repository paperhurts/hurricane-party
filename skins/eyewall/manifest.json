{
  "format": "hp-skin/1",
  "name": "Eyewall",
  "author": "hurricane-party",
  "authoredScale": 1,

  "sheets": {
    "chrome": { "1": "chrome.png", "2": "chrome@2x.png" }
  },

  "art": "mask",
  "glow": "renderer",

  "palette": {
    "void": "#0C0A14",
    "well": "#05040A",
    "filament": "#E8F4FF",
    "arc": "#6FE3FF",
    "strike": "#FF4FD8",
    "ember": "#FFB347"
  },

  "viscolor": [
    "#04160B", "#06280F", "#0A3D14", "#0F5418", "#15701C", "#1C8F20",
    "#2FAE22", "#57C723", "#86DC24", "#B8ED26", "#E2F52B", "#FFF03A",
    "#FFD534", "#FFB62D", "#FF9426", "#FF7020", "#FF4C1B", "#F52D1D",
    "#DC1A28", "#C21340", "#B01466", "#C21D97", "#E236C8", "#FF7BEC"
  ],

  "visualizer": { "component": "spectrum-bars", "options": { "bars": 19, "peakHold": true } },

  "fonts": {
    "chrome": { "type": "system", "size": 9, "case": "upper", "tracking": 0.08 },
    "clock":  { "type": "system", "size": 17, "case": "none", "tracking": -0.03 },
    "tag":    { "type": "system", "size": 6, "case": "upper", "tracking": 0.1 },
    "strip":  { "type": "system", "size": 11, "case": "none", "tracking": 0 },
    "label":  { "type": "system", "size": 6, "case": "none", "tracking": 0.08 },
    "scale":  { "type": "system", "size": 6, "case": "none", "tracking": 0.05 },
    "row":    { "type": "system", "size": 9, "case": "none", "tracking": 0 }
  },

  "windows": {
    "main": {
      "size": [275, 116],
      "resizable": false,
      "elements": {
        "frame": { "type": "nineslice", "rect": "fill",
                   "sprite": { "sheet": "chrome", "rect": [0, 0, 8, 8], "tint": "arc" },
                   "insets": [1, 1, 1, 1], "opacity": 0.3 },

        "titlebar": { "type": "image", "rect": [0, 0, 275, 14],
                      "sprite":   { "sheet": "chrome", "rect": [0, 16, 275, 14], "tint": "arc" },
                      "inactive": { "sheet": "chrome", "rect": [0, 32, 275, 14], "tint": "filament" },
                      "role": "drag" },
        "title": { "type": "text", "rect": [4, 0, 199, 14], "font": "chrome", "bind": "windowTitle",
                   "tint": "arc", "inactive": { "tint": "filament" } },
        "minimize": { "type": "button", "rect": [207, 2, 13, 9],
                      "sprite":   { "sheet": "chrome", "rect": [0, 48, 13, 9], "tint": "arc" },
                      "hover":    { "sheet": "chrome", "rect": [14, 48, 13, 9], "tint": "arc" },
                      "active":   { "sheet": "chrome", "rect": [28, 48, 13, 9], "tint": "arc" },
                      "inactive": { "sheet": "chrome", "rect": [42, 48, 13, 9], "tint": "filament" },
                      "action": "minimize" },
        "shade": { "type": "toggle", "rect": [224, 2, 13, 9],
                   "sprite":   { "sheet": "chrome", "rect": [0, 58, 13, 9], "tint": "arc" },
                   "hover":    { "sheet": "chrome", "rect": [14, 58, 13, 9], "tint": "arc" },
                   "active":   { "sheet": "chrome", "rect": [28, 58, 13, 9], "tint": "arc" },
                   "inactive": { "sheet": "chrome", "rect": [42, 58, 13, 9], "tint": "filament" },
                   "on": {
                     "sprite":   { "sheet": "chrome", "rect": [0, 88, 13, 9], "tint": "arc" },
                     "hover":    { "sheet": "chrome", "rect": [14, 88, 13, 9], "tint": "arc" },
                     "active":   { "sheet": "chrome", "rect": [28, 88, 13, 9], "tint": "arc" },
                     "inactive": { "sheet": "chrome", "rect": [42, 88, 13, 9], "tint": "filament" }
