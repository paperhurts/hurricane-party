                  "hover":    { "sheet": "chrome", "rect": [14, 68, 13, 9], "tint": "arc" },
                  "active":   { "sheet": "chrome", "rect": [28, 68, 13, 9], "tint": "arc" },
                  "inactive": { "sheet": "chrome", "rect": [42, 68, 13, 9], "tint": "filament" },
                  "on": {
                    "sprite":   { "sheet": "chrome", "rect": [0, 78, 13, 9], "tint": "arc" },
                    "hover":    { "sheet": "chrome", "rect": [14, 78, 13, 9], "tint": "arc" },
                    "active":   { "sheet": "chrome", "rect": [28, 78, 13, 9], "tint": "arc" },
                    "inactive": { "sheet": "chrome", "rect": [42, 78, 13, 9], "tint": "filament" }
