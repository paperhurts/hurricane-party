                    "active": { "sheet": "chrome", "rect": [36, 231, 17, 14], "tint": "strike" }
                  },
                  "action": "stop", "bind": "playState", "when": "stopped" },
        "next": { "type": "button", "rect": [76, 97, 17, 14],
                  "sprite": { "sheet": "chrome", "rect": [0, 141, 17, 14], "tint": "arc" },
                  "hover":  { "sheet": "chrome", "rect": [18, 141, 17, 14], "tint": "arc" },
                  "active": { "sheet": "chrome", "rect": [36, 141, 17, 14], "tint": "arc" },
                  "action": "next" },

