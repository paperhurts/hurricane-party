                     "active": { "sheet": "chrome", "rect": [36, 201, 17, 14], "tint": "arc" }
                   },
                   "action": "pause", "bind": "playState", "when": "paused" },
        "stop": { "type": "toggle", "rect": [58, 97, 17, 14],
